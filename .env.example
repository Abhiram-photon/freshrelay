# FreshRelay — environment variables
# Copy to .env and adjust. See docs/DEPLOYMENT.md for the Neon/Vercel path.

# ---------------------------------------------------------------------------
# Database (Prisma — PostgreSQL)
# ---------------------------------------------------------------------------
# Local dev via `docker compose up db`, or any Postgres 16 instance.
# Neon (used in production) works with the same URL — pooled string recommended
# on serverless (host contains "-pooler").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freshrelay

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# HMAC secret for pickup-code hashing. MUST be changed in any shared/production
# deployment. Rotating it invalidates all unverified pickup codes.
APP_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Business rules (all optional — defaults shown)
# ---------------------------------------------------------------------------
# Meals-equivalent estimate: meals = kg / KG_PER_MEAL (1 meal ≈ 0.4 kg food).
KG_PER_MEAL=0.4
# Unconfirmed reservation holds release stock after this many minutes.
HOLD_TIMEOUT_MINUTES=30
# Nearby-listing email digests: min minutes between digests per recipient.
DIGEST_MIN_INTERVAL_MINUTES=60
# Providers are alerted once when a listing is expiring within this window.
EXPIRING_SOON_WINDOW_MINUTES=60

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
# Set to 1 to disable the background jobs worker (e.g. on serverless, where
# long-running loops do not fit — see docs/DEPLOYMENT.md).
FRESHRELAY_DISABLE_WORKER=0
